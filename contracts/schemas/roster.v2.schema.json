{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:specter-arena:contract:roster:v2",
  "title": "Roster response v2",
  "description": "Body of GET /api/roster?view=signals: roster v1 with roster-item v2 items (the waiting condition and tokenReading). GET /api/roster without a view stays roster v1. Members, notes and paging are as in v1.",
  "type": "object",
  "properties": {
    "contractVersion": {
      "type": "integer",
      "const": 2
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "urn:specter-arena:contract:roster-item:v2"
      },
      "maxItems": 200
    },
    "nextCursor": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "rosterRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "collector": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,47}$"
        },
        "reasonCode": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "sinceMs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "state",
        "reasonCode",
        "sinceMs"
      ],
      "additionalProperties": false
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 1000000
          }
        },
        "required": [
          "code",
          "count"
        ],
        "additionalProperties": false
      },
      "maxItems": 8
    }
  },
  "required": [
    "contractVersion",
    "items",
    "nextCursor",
    "rosterRevision",
    "collector",
    "notes"
  ],
  "additionalProperties": false
}
