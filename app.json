{
  "name": "specter-arena",
  "version": "0.0.0",
  "minKiroCrewVersion": "0.12.0",
  "displayName": "Specter Arena",
  "description": "Specter Arena repository foundation. No product features yet.",
  "backend": {
    "entryPoint": "backend/app.py",
    "type": "asgi",
    "healthCheck": "/health",
    "routes": "/api/apps/specter-arena"
  },
  "permissions": {
    "api": [
      "/apps/specter-arena/api/*"
    ]
  },
  "ui": {
    "entry": "dist/index.mjs",
    "pages": [
      {
        "route": "/apps/specter-arena",
        "label": "Specter Arena",
        "icon": "Package"
      }
    ]
  }
}
