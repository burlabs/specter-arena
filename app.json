{
  "name": "specter-arena",
  "version": "0.1.0",
  "minKiroCrewVersion": "0.12.0",
  "displayName": "Specter Arena",
  "description": "Monitor your Kiro Crew bots: condition, attempts and collection coverage.",
  "backend": {
    "entryPoint": "backend/app.py",
    "type": "asgi",
    "healthCheck": "/health",
    "routes": "/api/apps/specter-arena"
  },
  "permissions": {
    "api": [
      "/apps/specter-arena/api/*",
      "/api/agents"
    ],
    "events": [
      "slots:user"
    ]
  },
  "ui": {
    "entry": "dist/index.mjs",
    "pages": [
      {
        "route": "/apps/specter-arena",
        "label": "Specter Arena",
        "icon": "Package"
      }
    ]
  }
}
