{
  "name": "specter-arena-infra",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "synth": "cdk synth --quiet",
    "test": "vitest run --coverage",
    "bootstrap": "node scripts/assert-aws-account.mjs && cdk bootstrap --qualifier specter --profile specter-preview",
    "deploy": "node scripts/assert-aws-account.mjs && cdk deploy --profile specter-preview",
    "destroy": "node scripts/assert-aws-account.mjs && cdk destroy --profile specter-preview"
  },
  "dependencies": {
    "aws-cdk-lib": "2.275.0",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "aws-cdk": "2.1148.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
